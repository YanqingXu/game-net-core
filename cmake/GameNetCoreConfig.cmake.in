@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(GameNetCore_LICENSE "Apache-2.0")
set_and_check(GameNetCore_LICENSE_FILE "@PACKAGE_GAMENET_INSTALL_DOCDIR@/LICENSE")
set_and_check(GameNetCore_NOTICE_FILE "@PACKAGE_GAMENET_INSTALL_DOCDIR@/NOTICE")
set_and_check(
    GameNetCore_THIRD_PARTY_NOTICES_FILE
    "@PACKAGE_GAMENET_INSTALL_DOCDIR@/THIRD_PARTY_NOTICES.md"
)

find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/GameNetCoreTargets.cmake")

set(GameNetCore_rpc_FOUND TRUE)

set(GameNetCore_websocket_FOUND FALSE)
if("websocket" IN_LIST GameNetCore_FIND_COMPONENTS AND @GAMENET_ENABLE_WEBSOCKET@)
    include("${CMAKE_CURRENT_LIST_DIR}/GameNetWebSocketTargets.cmake")
    set(GameNetCore_websocket_FOUND TRUE)
endif()
if(GameNetCore_FIND_REQUIRED_websocket AND NOT GameNetCore_websocket_FOUND)
    set(GameNetCore_NOT_FOUND_MESSAGE "Required component websocket is unavailable; install a package built with GAMENET_ENABLE_WEBSOCKET=ON.")
endif()

# TLS is a separate export: Core-only consumers never need OpenSSL, including
# when this package was built with TLS enabled.
set(GameNetCore_tls_FOUND FALSE)
if(("tls" IN_LIST GameNetCore_FIND_COMPONENTS OR "rpc_tls" IN_LIST GameNetCore_FIND_COMPONENTS)
   AND @GAMENET_ENABLE_TLS@)
    find_dependency(OpenSSL 3.0 COMPONENTS SSL)
    include("${CMAKE_CURRENT_LIST_DIR}/GameNetTlsTargets.cmake")
    set(GameNetCore_tls_FOUND TRUE)
endif()
set(GameNetCore_rpc_tls_FOUND FALSE)
if("rpc_tls" IN_LIST GameNetCore_FIND_COMPONENTS AND @GAMENET_ENABLE_TLS@)
    include("${CMAKE_CURRENT_LIST_DIR}/GameNetRpcTlsTargets.cmake")
    set(GameNetCore_rpc_tls_FOUND TRUE)
endif()
if(GameNetCore_FIND_REQUIRED_rpc_tls AND NOT GameNetCore_rpc_tls_FOUND)
    set(GameNetCore_NOT_FOUND_MESSAGE
        "Required component rpc_tls is unavailable; install a package built with GAMENET_ENABLE_TLS=ON.")
endif()
if(GameNetCore_FIND_REQUIRED_tls AND NOT GameNetCore_tls_FOUND)
    set(GameNetCore_NOT_FOUND_MESSAGE
        "Required component tls is unavailable; install a package built with GAMENET_ENABLE_TLS=ON.")
endif()

set(GameNetCore_EXPERIMENTAL_IO_URING_API_VERSION "0.1.0")
set(GameNetCore_experimental_io_uring_FOUND FALSE)
if(TARGET GameNet::experimental_io_uring)
    set(GameNetCore_experimental_io_uring_FOUND TRUE)
endif()
if(GameNetCore_FIND_REQUIRED_experimental_io_uring
   AND NOT GameNetCore_experimental_io_uring_FOUND)
    set(GameNetCore_NOT_FOUND_MESSAGE
        "Required component experimental_io_uring is unavailable; install a Linux package configured with GAMENET_ENABLE_EXPERIMENTAL=ON."
    )
endif()

check_required_components(GameNetCore)
