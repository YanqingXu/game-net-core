@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(GameNetCore_LICENSE "Apache-2.0")
set_and_check(GameNetCore_LICENSE_FILE "@PACKAGE_GAMENET_INSTALL_DOCDIR@/LICENSE")
set_and_check(GameNetCore_NOTICE_FILE "@PACKAGE_GAMENET_INSTALL_DOCDIR@/NOTICE")
set_and_check(
    GameNetCore_THIRD_PARTY_NOTICES_FILE
    "@PACKAGE_GAMENET_INSTALL_DOCDIR@/THIRD_PARTY_NOTICES.md"
)

find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/GameNetCoreTargets.cmake")

set(GameNetCore_EXPERIMENTAL_IO_URING_API_VERSION "0.1.0")
set(GameNetCore_experimental_io_uring_FOUND FALSE)
if(TARGET GameNet::experimental_io_uring)
    set(GameNetCore_experimental_io_uring_FOUND TRUE)
endif()
if(GameNetCore_FIND_REQUIRED_experimental_io_uring
   AND NOT GameNetCore_experimental_io_uring_FOUND)
    set(GameNetCore_NOT_FOUND_MESSAGE
        "Required component experimental_io_uring is unavailable; install a Linux package configured with GAMENET_ENABLE_EXPERIMENTAL=ON."
    )
endif()

check_required_components(GameNetCore)
